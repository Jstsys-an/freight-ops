# Slack 雙模型橋接（supabase/functions/slack-bridge）所需環境變數
# 本檔只列「變數名稱」，實際值請填進各自環境，切勿提交。

# --- Slack ---
SLACK_BOT_TOKEN=        # xoxb-...（Bot User OAuth Token）
SLACK_SIGNING_SECRET=   # Slack App Basic Information -> Signing Secret

# --- 模型 API ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=           # 選填，程式內有預設
ANTHROPIC_MODEL=        # 選填，程式內有預設
MAX_ROUNDS=             # 選填，自動接力上限，程式內預設 6

# --- Supabase（既有腳本也用這兩個名稱）---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=   # service_role secret（Project Settings -> API）
