# 環境變數範本：只列名稱與用途，不放值。
# 複製成 .env 後填值；.env 已在 .gitignore（請勿提交真實金鑰）。
#
# ── 既有腳本（GitHub Actions 備份 / scripts/）──
SUPABASE_URL=                 # Supabase 專案 URL，例如 https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=         # service_role secret key（繞過 RLS），備份腳本用

# ── Slack 雙模型橋接 Edge Function（supabase/functions/slack-bridge）──
# 用 `supabase secrets set --env-file .env` 推到 Edge Function；
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY 在 Edge Function 環境內建，不用另外設。
SLACK_BOT_TOKEN=              # Slack App 的 Bot User OAuth Token（xoxb-...）
SLACK_SIGNING_SECRET=         # Slack App → Basic Information → Signing Secret
OPENAI_API_KEY=               # OpenAI API key
OPENAI_MODEL=                 # 選填，預設 gpt-5.5（請依 OpenAI 官方模型清單調整）
OPENAI_REASONING_EFFORT=      # 選填，預設 low；用非推理模型時設成空字串
ANTHROPIC_API_KEY=            # Anthropic API key
ANTHROPIC_MODEL=              # 選填，預設 claude-opus-5-5
GPT_ICON=                     # 選填，GPT 的頭像：emoji（預設 :robot_face:）或圖片 URL
CLAUDE_ICON=                  # 選填，Claude 的頭像：emoji（預設 :sparkles:）或圖片 URL
BRIDGE_MAX_TURNS=             # 選填，每個討論串 AI 回覆上限，預設 2（GPT 一則 + Claude 一則）
