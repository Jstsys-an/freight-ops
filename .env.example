# ============================================================
# 環境變數範本：複製成 .env 後填入實際值（.env 已在 .gitignore，不會提交）。
# 這個檔只列「變數名稱」，不放任何實際的密鑰／金鑰。
# 註解一律獨立成行，等號後面不要接註解（dotenv 類工具會把 `# ...` 當成值）。
# ============================================================

# ---------- 既有：Supabase（scripts/*.ps1、GitHub Actions 備份、本機 serve 共用） ----------
# Supabase 專案 URL，例如 https://<project-ref>.supabase.co
SUPABASE_URL=
# service_role secret key（繞過 RLS）：只能留在本機 .env，絕不提交。
# Edge Function 環境內建 SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY（新版叫 SUPABASE_SECRET_KEYS），
# 部署到雲端時不用、也不能用 supabase secrets set 設 SUPABASE_ 開頭的變數；程式三種名稱都會認。
SUPABASE_SERVICE_KEY=

# ---------- Slack bridge（supabase/functions/slack-bridge） ----------
# 下面這些設在 Supabase Edge Secrets（supabase secrets set ...），見 docs/slack-bridge.md。

# Slack App 的 Bot User OAuth Token（xoxb-...）
SLACK_BOT_TOKEN=
# Slack App → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=

# OpenAI（GPT 身分）
OPENAI_API_KEY=
# 選填，預設 gpt-5.5
OPENAI_MODEL=
# 選填，預設 low；可填 none / minimal / low / medium / high / xhigh / max，
# 用不支援 reasoning 參數的模型時填 off（不送這個參數）
OPENAI_REASONING_EFFORT=

# Anthropic（Claude 身分）
ANTHROPIC_API_KEY=
# 選填，預設 claude-opus-5-5
ANTHROPIC_MODEL=

# 頭像（選填）：emoji（例如 :robot_face:）或圖片 URL（https:// 開頭自動用 icon_url）
# GPT 預設 :robot_face:
GPT_ICON=
# Claude 預設 :sparkles:
CLAUDE_ICON=

# 每個討論串的回合上限（安全閥，正整數，預設 6；一回合 = GPT 一句 + Claude 一句）
MAX_ROUNDS=
