# ============================================================
# 環境變數範本：複製成 .env 後填入實際值（.env 已在 .gitignore，不會提交）。
# 這個檔只列「變數名稱」，不放任何實際的密鑰／金鑰。
# ============================================================

# ---------- 既有：Supabase（scripts/*.ps1 與 Edge Function 共用） ----------
# service_role secret key 會繞過 RLS，只能留在本機 .env 或 Supabase Edge Secrets，絕不提交。
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------- Slack bridge（supabase/functions/slack-bridge） ----------
# 下面這些設在 Supabase Edge Secrets（supabase secrets set ...），見 docs/slack-bridge.md。
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# OpenAI（GPT 身分）
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic（Claude 身分）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 每個討論串的回合上限（安全閥，預設 6）
MAX_ROUNDS=
